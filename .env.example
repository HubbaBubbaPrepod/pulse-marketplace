# Generate local secrets with: node scripts/setup-local-env.mjs
PG_PASSWORD=replace-with-a-long-random-password
PG_PORT=54329
DATABASE_URL=postgresql://pulse_marketplace:replace-with-a-long-random-password@127.0.0.1:54329/pulse_marketplace
API_PORT=3101
PUBLIC_ORIGIN=http://127.0.0.1:3100
PACKAGE_DIRECTORY=../../data/packages
NODE_ENV=development
MAIL_TOKEN_KEY=replace-with-64-lowercase-hex-characters
# Optional GitHub public-read token for discovery (never sent to the browser).
GITHUB_READ_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=
MAIL_FROM=
# DISCOVERY_ENABLED=false disables periodic discovery.
# API_ORIGIN=http://127.0.0.1:3101 is a server-only Next setting;
# export it in the web process environment if using a nondefault API port.
