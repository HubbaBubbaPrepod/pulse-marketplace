{
  "name": "@pulse-marketplace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace @pulse-marketplace/contracts && tsc",
    "dev": "npm run build && node --env-file=../../.env --watch dist/main.js",
    "start": "node --env-file=../../.env dist/main.js",
    "lint": "npm run build --workspace @pulse-marketplace/contracts && tsc --noEmit",
    "test": "npm run build && node --env-file=../../.env --test test/*.test.mjs",
    "migrate": "npm run build && node --env-file=../../.env dist/database/migrate.js",
    "scan": "npm run build && node --env-file=../../.env dist/discovery/scan.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@pulse-marketplace/contracts": "*",
    "nodemailer": "10.1.4",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
